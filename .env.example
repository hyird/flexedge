# 只需配置 PostgreSQL 与初始管理员密码；运行时加密主密钥会在首次启动时自动生成并追加到本文件。
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-strong-database-password
DB_DATABASE=flexedge

# Redis 用于日志缓冲和运行态热数据；默认使用本机 Redis。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_POOL_SIZE_PER_WORKER=2
REDIS_BLOCKING_POOL_SIZE_PER_WORKER=1

# Redis 原子配额：capacity 个请求在 window_ms 毫秒内补充；支持短时突发。
OUTBOUND_RATE_GLOBAL_CAPACITY=8
OUTBOUND_RATE_GLOBAL_WINDOW_MS=1000
OUTBOUND_RATE_ACCOUNT_CAPACITY=2
OUTBOUND_RATE_ACCOUNT_WINDOW_MS=1000
OUTBOUND_RATE_MAX_WAIT_MS=5000
API_RATE_GLOBAL_CAPACITY=2000
API_RATE_GLOBAL_WINDOW_MS=1000
API_RATE_ADDRESS_CAPACITY=120
API_RATE_ADDRESS_WINDOW_MS=1000
API_RATE_TENANT_CAPACITY=500
API_RATE_TENANT_WINDOW_MS=1000
API_RATE_ADMIN_CAPACITY=60
API_RATE_ADMIN_WINDOW_MS=1000
AUTH_RATE_ADDRESS_CAPACITY=20
AUTH_RATE_ADDRESS_WINDOW_MS=60000

# 仅在全新数据库的首次启动时使用；固定初始管理员用户名为 admin。
INITIAL_ADMIN_PASSWORD=replace-with-an-initial-password-of-at-least-8-characters

# HTTP 默认监听 127.0.0.1:1102；直接对外提供服务时可设 HOST=0.0.0.0、PORT=80。
# HOST=127.0.0.1
# PORT=1102
# 同时配置以下两个 PEM 文件路径即可启用 HTTPS；相对路径以 .env 所在目录为准。
# HTTPS_CERT_FILE=/opt/flexedge/certs/fullchain.pem
# HTTPS_KEY_FILE=/opt/flexedge/certs/privkey.pem
# HTTPS_PORT=443
# 自动跳转默认关闭；设为 true 后 HTTP 请求以 308 跳转至 HTTPS，须先配置上述证书。
HTTP_REDIRECT_TO_HTTPS=false
