{
  "name": "flexedge-console",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "build": "bun run typecheck && vite build",
    "build:web": "bun run build",
    "start": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "lint": "eslint web",
    "typecheck": "bun run routes:generate && tsc --noEmit",
    "routes:generate": "bun tools/generate-routes.ts",
    "format": "prettier --write web package.json vite.config.ts tsconfig.json",
    "format:check": "prettier --check web package.json vite.config.ts tsconfig.json"
  },
  "dependencies": {
    "@gravity-ui/icons": "2.23.0",
    "@heroui-pro/react": "1.0.0-beta.10",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@hookform/resolvers": "5.9.1",
    "@react-aria/utils": "3.34.1",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-router": "1.170.44",
    "axios": "1.20.0",
    "clsx": "2.1.1",
    "motion": "14.3.0",
    "re2js": "2.8.6",
    "react": "19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-resizable-panels": "4.14.5",
    "react-stately": "3.51.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.104.3",
    "@tanstack/router-generator": "1.167.44",
    "@tanstack/router-plugin": "1.168.46",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.5"
  },
  "trustedDependencies": [
    "@heroui-pro/react",
    "heroui-pro",
    "@zowe/secrets-for-zowe-sdk"
  ]
}
