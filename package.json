{
  "name": "flexedge-console",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "build": "bun run typecheck && vite build",
    "build:web": "bun run build",
    "start": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "lint": "eslint web",
    "typecheck": "bun run routes:generate && tsc --noEmit",
    "routes:generate": "bun tools/generate-routes.ts",
    "format": "prettier --write web package.json vite.config.ts tsconfig.json",
    "format:check": "prettier --check web package.json vite.config.ts tsconfig.json"
  },
  "dependencies": {
    "@gravity-ui/icons": "2.18.0",
    "@heroui-pro/react": "1.0.0-beta.10",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@hookform/resolvers": "^5.2.2",
    "@react-aria/utils": ">=3.34.1",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-router": "^1.168.22",
    "axios": "^1.15.0",
    "clsx": "^2.1.1",
    "motion": "^12.38.0",
    "re2js": "^2.8.6",
    "react": "^19.2.5",
    "react-aria": ">=3.52.1",
    "react-aria-components": ">=1.21.1",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.72.1",
    "react-resizable-panels": "^4.0.0",
    "react-stately": ">=3.50.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": ">=3.3.1",
    "tailwindcss": "^4.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/eslint-plugin-query": "^5.99.0",
    "@tanstack/router-generator": "1.167.33",
    "@tanstack/router-plugin": "^1.167.22",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.4"
  },
  "trustedDependencies": [
    "@heroui-pro/react",
    "heroui-pro",
    "@zowe/secrets-for-zowe-sdk"
  ]
}
