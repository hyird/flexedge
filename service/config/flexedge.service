[Unit]
Description=FlexEdge Server
After=network-online.target postgresql.service redis.service
Wants=network-online.target redis.service
Requires=postgresql.service redis.service

[Service]
Type=simple
User=flexedge
Group=flexedge
WorkingDirectory=/opt/flexedge
ExecStart=/opt/flexedge/server
Environment=FLEXEDGE_XDB_V4_PATH=/opt/flexedge/geo/ip2region_v4.xdb
Environment=FLEXEDGE_XDB_V6_PATH=/opt/flexedge/geo/ip2region_v6.xdb
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=0
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/flexedge/.env

[Install]
WantedBy=multi-user.target
